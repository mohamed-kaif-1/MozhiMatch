    "eval:holdout": "node --experimental-strip-types scripts/evaluate.ts --split holdout"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "papaparse": "^5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.1.1"
  }
