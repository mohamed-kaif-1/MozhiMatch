# AI Configuration
AI_MODE=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Deployment
DEPLOYMENT_MODE=public_demo
APP_ORIGIN=http://localhost:3000

# Optional Private Operator Access
DEMO_ACCESS_CODE=

# Shared Redis Quota Storage
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Usage Protection
REQUIRE_SHARED_QUOTA=true
GLOBAL_AI_MAX_REQUESTS=100
RATE_LIMIT_ANALYZE_MAX=30
RATE_LIMIT_CORRECTION_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60